# ─────────────────────────────────────────────────────────
# Tibra Foods — Environment Variables
# Copy this file to .env.local and fill in your real values
# ─────────────────────────────────────────────────────────

# ── EmailJS Configuration ──────────────────────────────
# Get these from https://www.emailjs.com/
# 1. Create an account on EmailJS
# 2. Add an Email Service (Gmail, Outlook, etc.)
# 3. Create two Email Templates:
#    - One for Contact form  (template vars: from_name, from_email, service, message)
#    - One for Order form    (template vars: from_name, from_email, phone, country,
#                             date_type, quantity, message, product_name)
# 4. Copy your Public Key from Account > API Keys

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id_here
NEXT_PUBLIC_EMAILJS_ORDER_TEMPLATE_ID=your_order_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# ── EmailJS SDK is loaded via CDN in layout.tsx ──────────
# No npm install required — already integrated
